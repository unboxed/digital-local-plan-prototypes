{#
  Side navigation ("sidebar") component.

  Shows a list of steps/tasks in a process, optionally grouped into sections with headings,
  so users can orientate and jump between them. The current step is marked with `active: true`.

  Usage:
    {% from "partials/side-navigation/macro.njk" import appSideNavigation %}
    {{ appSideNavigation({ sections: [...], ariaLabel: "..." }) }}

  params.sections: array of { heading?: string, items: [] } — omit heading for an ungrouped list
  params.sections[].items[].text: string (required) — link text
  params.sections[].items[].href: string (required) — link destination
  params.sections[].items[].active: boolean (optional) — marks the current page
  params.sections[].items[].status: string (optional) — one of "Completed" | "In progress" |
    "Not started" | "Cannot start" | "Action required", rendered as the matching status icon
    (see partials/icons/status-icon.html — adapted from BOPS). Anything else renders no icon.
  params.ariaLabel: string (optional) — defaults to "Task navigation"
  params.classes: string (optional) — extra classes on the outer <nav>
#}

{% from "partials/icons/status-icon.html" import statusIcon %}

{% macro appSideNavigation(params) %}
<nav class="app-side-navigation {%- if params.classes %} {{ params.classes }}{% endif %}"
     aria-label="{{ params.ariaLabel | default('Task navigation') }}">
  {% for section in params.sections %}
    <div class="app-side-navigation__section">
      {% if section.heading %}
        <h2 class="app-side-navigation__heading">
          <button type="button"
                  class="app-side-navigation__toggle"
                  aria-expanded="true"
                  data-app-side-navigation-toggle>
            {{ section.heading }}
          </button>
        </h2>
      {% endif %}
      <ul class="app-side-navigation__list">
        {% for item in section.items %}
          <li class="app-side-navigation__item {%- if item.active %} app-side-navigation__item--active{% endif %}">
            {% if item.status %}
              <span class="app-side-navigation__icon">{{ statusIcon(item.status) }}</span>
            {% endif %}
            <a class="govuk-link govuk-link--no-visited-state app-side-navigation__link"
               href="{{ item.href }}"
               {%- if item.active %} aria-current="page"{% endif %}>
              {{ item.text }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</nav>
{% endmacro %}
