{#
  Site-wide, non-crown-branded service header (see CLAUDE.md's "No crown branding" rule — this
  is a custom header, not GOV.UK Frontend's branded header/crest). Shows the organisation and
  service name and, once you're in a plan, a nav row of the plan's sections (app/data/site-map.js)
  with the current one highlighted. Rendered from layouts/main.html's `header` block.

  Usage:
    {% from "partials/service-header/macro.njk" import appServiceHeader %}
    {{ appServiceHeader({ activeSection: activeSection, sections: siteSections, organisationName: organisationName, serviceName: serviceName }) }}

  Note: every value must be passed explicitly, not read as bare globals — a Nunjucks macro
  imported without "with context" (the default, and what we use here) doesn't inherit the
  calling template's context, only its own explicit parameters.

  params.activeSection: 'intro' (home and plan start: no nav) | 'home' (plan maker home) | a
  section id from site-map.js. Set by routes.js middleware from the URL.
  params.sections: site-map.js SECTIONS.
  params.organisationName, params.serviceName: string (required) — see app/config.json
#}

{% macro appServiceHeader(params) %}
<header class="app-service-header">
  <div class="app-service-header__inner">
    <p class="app-service-header__org">{{ params.organisationName }}</p>
    <div class="app-service-header__service">
      <p class="app-service-header__service-name">{{ params.serviceName }}</p>
      {% if params.activeSection != "intro" %}
      <nav class="app-service-header__nav" aria-label="Plan sections">
        <ul class="app-service-header__nav-list">
          <li class="app-service-header__nav-item">
            <a class="app-service-header__nav-link {%- if params.activeSection == 'home' %} app-service-header__nav-link--active{% endif %}"
               href="/plan" {%- if params.activeSection == 'home' %} aria-current="page"{% endif %}>Plan maker home</a>
          </li>
          {% for section in params.sections %}
          <li class="app-service-header__nav-item">
            <a class="app-service-header__nav-link {%- if params.activeSection == section.id %} app-service-header__nav-link--active{% endif %}"
               href="{{ section.href }}" {%- if params.activeSection == section.id %} aria-current="true"{% endif %}>{{ section.title }}</a>
          </li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </div>
    {# Back to the site's home page, from anywhere (the external header has it too). #}
    <a class="app-header-home" href="/">Prototypes home</a>
  </div>
</header>
{% endmacro %}
